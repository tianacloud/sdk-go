<view class="page">
  <view class="eyebrow">TIANA FUNCTION DEMO</view>
  <view class="title">微信身份 · 函数验证</view>
  <view class="description">用你的小程序微信身份调用函数，函数从已验证的会话中识别当前用户。</view>
  <view class="card">
    <view class="label">登录状态</view>
    <view class="status">{{status}}</view>
    <button class="primary" bindtap="login" loading="{{busy}}" disabled="{{busy}}">{{loggedIn ? '重新微信登录' : '微信登录'}}</button>
    <view wx:if="{{loggedIn}}" class="identity">
      <view>AppID</view><text user-select="{{true}}">{{appID}}</text>
      <view>服务端确认的 OpenID</view><text user-select="{{true}}">{{openID}}</text>
      <view>会话到期</view><text>{{expiry}}</text>
    </view>
  </view>
  <view class="card">
    <view class="label">调用业务函数</view>
    <input class="input" value="{{message}}" bindinput="updateMessage" placeholder="给函数发一句话" />
    <button class="secondary" bindtap="callFunction" disabled="{{busy || !loggedIn}}">发送并读取当前身份</button>
    <text wx:if="{{reply}}" class="reply" user-select="{{true}}">{{reply}}</text>
  </view>
  <view class="card">
    <view class="label">身份校验</view>
    <view class="description">检查缺少会话、篡改会话和自报其他用户三种请求。所有请求使用同一枚实例 Token。</view>
    <button class="secondary" bindtap="verify" disabled="{{busy || !loggedIn}}">运行三项检查</button>
    <view wx:for="{{checks}}" wx:key="name" class="check">
      <view class="{{item.passed ? 'pass' : 'fail'}}">{{item.passed ? '通过' : '未通过'}} · {{item.name}}</view>
      <view class="description">{{item.detail}}</view>
    </view>
  </view>
  <button class="clear" wx:if="{{loggedIn}}" bindtap="clearSession" disabled="{{busy}}">清除本机会话</button>
</view>
