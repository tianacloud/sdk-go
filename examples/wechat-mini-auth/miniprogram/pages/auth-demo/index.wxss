page { background: #f7f6f3; color: #232924; font-size: 28rpx; line-height: 1.6; }
.page { padding: 42rpx 30rpx 70rpx; }
.eyebrow { color: #65776b; font-size: 22rpx; letter-spacing: 3rpx; }
.title { margin: 12rpx 0 18rpx; font-size: 44rpx; font-weight: 700; }
.description { color: #626960; font-size: 26rpx; }
.card { margin-top: 28rpx; padding: 30rpx; background: #fff; border: 1px solid #e5e7df; border-radius: 20rpx; }
.label { font-size: 30rpx; font-weight: 600; margin-bottom: 14rpx; }
.status { margin-bottom: 24rpx; }
button { font-size: 28rpx; border-radius: 12rpx; margin-top: 20rpx; }
button::after { border: 0; }
.primary { background: #254a37; color: #fff; }
.secondary { background: #edf3ec; color: #254a37; }
.clear { background: transparent; color: #626960; }
.identity { margin-top: 24rpx; overflow-wrap: anywhere; }
.identity view { color: #626960; font-size: 24rpx; margin-top: 16rpx; }
.identity text { display: block; }
.input { background: #f7f6f3; padding: 16rpx; border-radius: 8rpx; }
.reply { display: block; margin-top: 24rpx; white-space: pre-wrap; overflow-wrap: anywhere; }
.check { margin-top: 24rpx; padding-top: 20rpx; border-top: 1px solid #e5e7df; }
.pass { color: #254a37; }
.fail { color: #a23a31; }
